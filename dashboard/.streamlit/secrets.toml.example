# Copy to secrets.toml (git-ignored). On Streamlit Community Cloud, paste this
# into the app's Secrets settings instead.
[connections.snowflake]
account = "xy12345.us-east-1"
user = "CFPB_DASHBOARD"
private_key_file = "secrets/cfpb_dashboard.p8"  # relative to where you run `streamlit run`
role = "REPORTER"
warehouse = "TRANSFORM_WH"
database = "ANALYTICS"
schema = "PROD"
client_session_keep_alive = true
# app.py uses ? placeholders (server-side binding).
paramstyle = "qmark"
