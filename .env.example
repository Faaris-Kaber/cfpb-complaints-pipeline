# Copy to .env and fill in. Never commit .env.

# --- AWS / ingestion ---
AWS_REGION=us-east-1
AWS_PROFILE=cfpb
S3_BUCKET=cfpb-complaints-CHANGEME
S3_RAW_PREFIX=raw/cfpb
S3_STATE_KEY=state/cfpb_watermark.json
LOOKBACK_DAYS=30
PAGE_SIZE=10000

# --- Snowflake (key-pair auth) ---
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=CFPB_SVC
# Use an absolute path: dbt runs from dbt/, so relative paths break.
SNOWFLAKE_PRIVATE_KEY_PATH=C:/path/to/CFPB/secrets/cfpb_svc.p8
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=TRANSFORM_WH
SNOWFLAKE_DATABASE=ANALYTICS
# dev schema: use your initials, e.g. DEV_FK. Prod runs use PROD.
SNOWFLAKE_SCHEMA=DEV_CHANGEME
