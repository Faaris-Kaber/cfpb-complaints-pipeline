{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::__BUCKET__"
    },
    {
      "Sid": "ReadWriteRawAndState",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::__BUCKET__/raw/cfpb/*",
        "arn:aws:s3:::__BUCKET__/state/*"
      ]
    }
  ]
}
